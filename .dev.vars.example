# Copy this file to .dev.vars and replace placeholders. Never commit .dev.vars.
BETTER_AUTH_SECRET=replace_with_a_random_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
ADMIN_EMAILS=your-email@gmail.com
TMDB_ACCESS_TOKEN=your_tmdb_api_read_access_token

# Used only by the Worker for personalized AI recommendations.
GEMINI_API_KEY=your_google_ai_studio_api_key
# Optional: defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
