/**
 * Cloudflare Workers configuration for Movie Hunt.
 * API requests must reach the Worker; remaining paths are served as the React SPA.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movie-hunt",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-23",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "movie_hunt_db",
      "database_name": "movie-hunt-db",
      "database_id": "d6da642b-c4a4-4957-9b45-deb405d78fd5",
      "migrations_dir": "migrations"
    }
  ]
}
